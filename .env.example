# Copy this file to .env in the same folder and fill in the two keys.
# Never commit .env. Never paste keys into a chat.
NEBIUS_API_KEY=your-key
TAVILY_API_KEY=your-key
NEBIUS_BASE_URL=https://api.tokenfactory.nebius.com/v1
# Set by Claude Code in HANDOFF.md step 3a:
NEBIUS_MODEL=nvidia/nemotron-3-super-120b-a12b
NEBIUS_EMBED_MODEL=Qwen/Qwen3-Embedding-8B
# Optional: set to local if no Token Factory embedding model works.
DDT_EMBED=
